{
  "name": "voiceflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,emerald\" \"pnpm --filter @voiceflow/api dev\" \"pnpm --filter @voiceflow/web dev\"",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "@prisma/client": "^6.4.1",
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  }
}
