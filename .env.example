# Database Connection
DATABASE_URL="postgresql://voiceflow:voiceflow_secret@localhost:5434/voiceflow_db?schema=public"
POSTGRES_PORT=5434

# Redis Connection
REDIS_URL="redis://localhost:6380"
REDIS_PORT=6380

# API Configuration
PORT=4000
NODE_ENV=development

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"

S3_ENDPOINT=http://localhost:9005
S3_REGION=us-east-1
S3_ACCESS_KEY=voiceflow_minio_user
S3_SECRET_KEY=voiceflow_minio_password
S3_BUCKET=voiceflow-recordings
S3_FORCE_PATH_STYLE=true

# Transcription
# local = free local development
# openai = OpenAI API
TRANSCRIPTION_PROVIDER=local

# Local transcription
LOCAL_TRANSCRIPTION_URL=http://localhost:8000
LOCAL_WHISPER_MODEL=base

# OpenAI transcription
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
